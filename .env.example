# Tea Factory Management System -- environment variables
#
# Copy to .env and edit, or set these in the service environment.
#
# NOTE: nothing in this repo loads .env automatically -- python-dotenv is
# deliberately not a dependency. To use this file with the dev server:
#
#     pip install python-dotenv
#     flask --app app --env-file .env run
#
# waitress-serve never reads .env, so for a deployed service set the variables
# in the environment instead, e.g. on Windows:
#
#     setx TEA_FACTORY_DB "D:\TeaFactory\tea_factory.sqlite3"
#
# (setx affects new shells only -- restart the service after changing it.)


# Where the SQLite database lives.
# Default: instance/tea_factory.sqlite3
# Container/Render example: /data/tea_factory.sqlite3
#
# Point this outside a OneDrive-synced folder for reliability; OneDrive's
# file locking has been known to corrupt SQLite databases.
TEA_FACTORY_DB=D:\TeaFactory\tea_factory.sqlite3


# Session signing key. If unset, a key is generated once into
# instance/secret_key (config.py: load_or_create_secret_key).
#
# Set it explicitly for a deployment so sessions survive a reinstall, and keep
# it secret -- anyone holding it can forge a session cookie. Production mode
# requires at least 32 random characters and rejects placeholders.
# Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
TEA_FACTORY_SECRET_KEY=change-me


# 1 = set the Secure flag on the session cookie.
# Only enable this once the app is served over HTTPS. Over plain HTTP nobody
# will be able to stay signed in.
TEA_FACTORY_SECURE_COOKIES=0


# 1 = print the demo account passwords on the sign-in screen.
# For seeded demo installs and local development only. Leave at 0 on a real
# deployment.
TEA_FACTORY_SHOW_DEMO_CREDENTIALS=0


# 1 = production mode. Refuses to start unless the secret key is supplied in
# the environment (32+ characters), secure cookies are on, and demo credentials
# are off. Also refuses `init-db --seed`.
TEA_FACTORY_PRODUCTION=0


# 1 = trust one reverse-proxy hop (Render and most PaaS hosts). This makes the
# real client IP available to the login throttle instead of the proxy's IP.
TEA_FACTORY_TRUST_PROXY=0


# Port used by the container entrypoint (the platform usually provides PORT).
PORT=8000


# Timezone for the server process. The factory rules use "today", so a UTC
# server would roll over at 05:30 Sri Lanka time. Set to Asia/Colombo.
TZ=Asia/Colombo
